{
  "schema": 1,
  "comment": "Spiel-Definitionen fuer die Erkennung. Ein neues Spiel braucht hier einen Eintrag und optional ein Plugin unter Tools/Plugins.",
  "games": [
    {
      "id": "f1",
      "name": "F1 (2015-2026)",
      "status": "stable",
      "plugin": "F1.ps1",
      "install": {
        "folderPattern": "^F1[ _\\-]?(2015|2016|2017|2018|2019|2020|2021|22|23|24|25|26)$",
        "registryNames": ["^F1[ _\\-]?(2015|2016|2017|2018|2019|2020|2021|22|23|24|25|26)\\b"],
        "marker": "actionmaps"
      },
      "user": {
        "paths": ["%DOCS%\\My Games"],
        "childPattern": "^F1[ _\\-]?(2015|2016|2017|2018|2019|2020|2021|22|23|24|25|26)$"
      },
      "backup": ["hardwaresettings", "actionmaps", "graphicsconfig", "settings"]
    },
    {
      "id": "assetto_corsa",
      "name": "Assetto Corsa",
      "status": "beta",
      "plugin": "AssettoCorsa.ps1",
      "install": {
        "folderNames": ["assettocorsa"],
        "registryNames": ["^Assetto Corsa$"],
        "marker": "AssettoCorsa.exe"
      },
      "user": {
        "paths": ["%DOCS%\\Assetto Corsa"]
      },
      "backup": ["cfg"]
    }
  ]
}
